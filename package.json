{
  "name": "melonpan-harness-root",
  "version": "0.1.0",
  "private": true,
  "description": "Melonpan agent harness monorepo for Kosen Festival",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @melonpan/core run build && pnpm --filter @melonpan/cli run build",
    "test": "pnpm -r run test",
    "test:cli": "tsx packages/core/examples/cli-test.ts",
    "demo": "tsx packages/core/examples/cli-subagent-test.ts --mode=auto",
    "demo:plan": "tsx packages/core/examples/cli-subagent-test.ts --mode=plan",
    "tui": "pnpm --filter @melonpan/cli run start"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
